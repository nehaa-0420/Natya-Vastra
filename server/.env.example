# ==============================================================================
# Natya Vastra — Backend Environment Configuration Example
# Copy to .env for local development, or set in Render Dashboard for production.
# ==============================================================================

# Server Network Settings
PORT=4000
HOST=0.0.0.0
NODE_OPTIONS=--experimental-sqlite

# CORS Allowed Origin
# In development: http://localhost:5173
# In production: https://YOUR-VERCEL-SITE.vercel.app (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173
ALLOW_VERCEL_PREVIEWS=false

# Authentication Secret (required in production; minimum 32 random characters)
JWT_SECRET=change-me-to-a-long-random-string

# Administrator Account
# Initialized when the database is empty. Change for production.
ADMIN_EMAIL=admin@natyavastra.local
ADMIN_PASSWORD=ChangeMe123!

# ── Primary Database & Persistent Storage (SQLite) ──────────────────────────
# For local dev, defaults to db/natya_vastra.db and uploads/
# On Render with a persistent disk mounted at /var/data:
# DB_PATH=/var/data/natya_vastra.db
# UPLOAD_DIR=/var/data/uploads
DB_PATH=
UPLOAD_DIR=

# ── MongoDB / Document Store (Inspections, Complaints, Damage Reports) ──────
# Recommended for production: MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/natya_vastra
# If unset, the backend uses a persistent file-backed document store.
MONGODB_URI=

# ── Razorpay Payment Gateway (Test Mode) ───────────────────────────────────
# Get test keys at https://dashboard.razorpay.com (Settings -> API Keys)
# Leave blank to run with WhatsApp booking confirmation without online checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Nodemailer Transactional SMTP ──────────────────────────────────────────
# Leave blank to bypass email dispatch without blocking bookings or complaints.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Natya Vastra <noreply@natyavastra.in>"

# ── AI Costume Assistant (Google Gemini) ───────────────────────────────────
# Free API key at https://aistudio.google.com -> Get API Key
# Leave blank to disable /assistant gracefully.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# How hard the model thinks: low (default, fastest), minimal, medium, high
# GEMINI_THINKING_LEVEL=low
