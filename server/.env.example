PORT=4000
CORS_ORIGIN=http://localhost:5173

# Used to sign login tokens. Use a long random string (required when NODE_ENV=production).
JWT_SECRET=change-me-to-a-long-random-string

# The admin account is created the first time the server starts.
ADMIN_EMAIL=admin@natyavastra.local
ADMIN_PASSWORD=ChangeMe123!

# ── Razorpay (test mode keys from https://dashboard.razorpay.com) ──────────
# Leave blank to disable online payment (customers fall back to WhatsApp).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Email (nodemailer SMTP) ────────────────────────────────────────────────
# Example for Gmail: host=smtp.gmail.com, port=587, user=you@gmail.com
# Leave blank to disable email notifications (bookings still work).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Natya Vastra <noreply@natyavastra.in>"

# ── AI costume assistant (Anthropic) ──────────────────────────────────────
# Leave blank to disable the /assistant page.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

