{
  "name": "natya-vastra-server",
  "version": "1.0.0",
  "description": "Node/Express + SQLite API for the Natya Vastra site",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite server.js",
    "dev": "nodemon --exec \"node --experimental-sqlite\" server.js",
    "seed": "node --experimental-sqlite db/seed.js",
    "migrate:mongo": "node --experimental-sqlite db/migrate.js",
    "test": "node --experimental-sqlite --test test/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.2",
    "multer": "^2.0.0",
    "nodemailer": "^10.1.0",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
